{
  "name": "PRL Parcitank",
  "short_name": "PRL Parcitank",
  "description": "Prevención de Riesgos Laborales — formaciones y aptos médicos",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F4F4F1",
  "theme_color": "#184280",
  "lang": "es",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "archivos",
          "accept": [
            ".xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "image/*"
          ]
        }
      ]
    }
  }
}